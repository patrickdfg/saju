{
  "name": "ondo-saju-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://patrickdfg.github.io",
    "GEMINI_MODEL": "gemini-3.8-flash"
  },
  "durable_objects": {
    "bindings": [{ "name": "SAJU_BUDGET", "class_name": "SajuBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SajuBudget"] }],
  "observability": { "enabled": false }
}
